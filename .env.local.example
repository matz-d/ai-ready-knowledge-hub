# Copy to .env.local and fill in (see docs/setup-gcp.md).
GOOGLE_CLOUD_PROJECT=ai-ready-knowledge-hub
GOOGLE_CLOUD_LOCATION=global

# GCS bucket for uploaded originals (W2 walking skeleton).
KNOWLEDGE_HUB_BUCKET=your-gcs-bucket-name

# Data/storage residency marker for audit metadata. Cloud Run / GCS / Firestore
# remain in Tokyo while Gemini 3.x inference uses GOOGLE_CLOUD_LOCATION=global.
KNOWLEDGE_HUB_DATA_RESIDENCY_LOCATION=asia-northeast1

# Optional: Firestore client prefers REST over gRPC (see docs/setup-gcp.md).
# FIRESTORE_PREFER_REST=true

# Context Package async (local UI). Production uses Docker build-arg; see docs/setup-gcp.md.
# NEXT_PUBLIC_CONTEXT_PACKAGE_ASYNC_ENABLED=true
# CONTEXT_PACKAGE_TASKS_QUEUE=context-package-jobs
# CONTEXT_PACKAGE_WORKER_BASE_URL=http://localhost:3000
# CONTEXT_PACKAGE_WORKER_SA_EMAIL=your-worker-sa@project.iam.gserviceaccount.com
# CONTEXT_PACKAGE_WORKER_OIDC_AUDIENCE=IAP_OAUTH_CLIENT_ID
# CONTEXT_PACKAGE_JOB_TOKEN=dev-only-shared-secret

# Optional: public hackathon demo mode. Disables arbitrary uploads and exposes
# curated synthetic sample import instead. Deploy this only to the public demo
# environment, not to the normal IAP-protected delivery environment.
# DEMO_MODE=true

# Optional: official-doc-pdf table-assist async ingest worker.
# If unset, these fall back to the Context Package Cloud Tasks env above.
# PDF_TABLE_ASSIST_TASKS_LOCATION=asia-northeast1
# PDF_TABLE_ASSIST_TASKS_QUEUE=table-assist-ingest
# PDF_TABLE_ASSIST_WORKER_BASE_URL=http://localhost:3000
# PDF_TABLE_ASSIST_WORKER_SA_EMAIL=your-worker-sa@project.iam.gserviceaccount.com
# PDF_TABLE_ASSIST_WORKER_OIDC_AUDIENCE=IAP_OAUTH_CLIENT_ID
# PDF_TABLE_ASSIST_WORKER_TOKEN=dev-only-shared-secret
# PDF_TABLE_ASSIST_TASK_SIGNING_SECRET=dev-only-task-signing-secret

# Optional model override (default: gemini-3.5-flash).
# The hackathon default uses the global Gemini endpoint because Gemini 3.x
# models were reachable there for this project on 2026-06-03.
# GEMINI_MODEL=gemini-3.5-flash

# Optional scan-pdf OCR model override (default: gemini-3.1-flash-lite).
# Keep OCR on Flash-Lite unless a quality comparison shows 3.5 Flash is needed.
# SCAN_PDF_GEMINI_MODEL=gemini-3.1-flash-lite

# Optional masker provider. Use cloud-dlp for Google Cloud Sensitive Data Protection.
# MASKER_PROVIDER=simple-rule

# Optional ADC: path to a service account JSON key. If unset, use
# `gcloud auth application-default login` (docs/setup-gcp.md). Same credential
# chain as other Google client libraries: Firestore, GCS uploads, Vertex/Gemini
# (curator), Cloud DLP when MASKER_PROVIDER=cloud-dlp, and Google Sheets/Drive
# import. Not masker-only; demo runbook often recommends an SA key for Drive.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account-key.json

# Optional: SA email when ADC credentials have no client_email (e.g. some
# metadata-server setups). Sheets import UI also uses this if the email cannot
# be read from the key file. Omit if your ADC JSON already includes client_email.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=xxxxx@xxxxx.iam.gserviceaccount.com
